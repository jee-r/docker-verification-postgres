{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "description": "Each base stage tracks a fixed PG major: never move it to another tag",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/(^|/)databasus/verification-postgres$/"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    },
    {
      "description": "Follow upstream: one grouped digest bump for all majors. GitHub native auto-merge merges the PR as soon as Build_Test passes (no wait for the next Renovate run), and the merge triggers Deploy",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/(^|/)databasus/verification-postgres$/"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "groupName": "upstream verification-postgres",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps",
      "prPriority": 10,
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Keep GitHub Actions current with no manual action",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "major", "digest"],
      "groupName": "github actions",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
